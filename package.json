{
  "description": "One dashboard for all your Better Auth apps — self-hosted on Cloudflare.",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@fission-ai/openspec": "1.15.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "authfleet",
  "packageManager": "pnpm@10.28.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm typecheck && pnpm test:unit && pnpm lint && pnpm build && pnpm spec:validate",
    "deploy": "node scripts/deploy.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter='!@authfleet/test-e2e'",
    "typecheck": "turbo run typecheck"
  },
  "version": "0.1.0"
}
