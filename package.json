{
  "description": "One dashboard for all your Better Auth apps — self-hosted on Cloudflare.",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@fission-ai/openspec": "1.15.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "authfleet",
  "packageManager": "pnpm@10.28.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "spec:validate": "openspec validate add-authfleet-v1 --strict && openspec validate add-agent-plugin --strict",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "version": "0.1.0"
}
