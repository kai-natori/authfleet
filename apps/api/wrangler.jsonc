{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2025-09-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "authfleet-registry",
      "migrations_dir": "migrations"
    }
  ],
  "main": "src/index.ts",
  "name": "authfleet-api",
  "observability": { "enabled": true },
  "triggers": { "crons": ["5 0 * * *"] },
  // No committed `vars` on purpose (audit F7): demo/dev-bypass flags are
  // absent = off. Local values belong in .dev.vars (see .dev.vars.example);
  // production values are set as Worker secrets/vars at deploy time.
  "workers_dev": false
}
