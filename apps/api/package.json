{
  "dependencies": {
    "@authfleet/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "miniflare": "5.20261113.0-beta",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "^4.150.0"
  },
  "name": "@authfleet/api",
  "private": true,
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:bundle": "node scripts/bundle-migrations.mjs && biome format --write src/db/migrations.generated.ts",
    "db:generate": "drizzle-kit generate && pnpm db:bundle",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8788",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
