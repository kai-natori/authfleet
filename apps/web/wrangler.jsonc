{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "run_worker_first": true },
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.mjs",
  "name": "authfleet-web",
  "observability": { "enabled": true },
  "services": [{ "binding": "API", "service": "authfleet-api" }],
  // No *.workers.dev hostname (audit F1): web must only be reachable on
  // the custom domain that the Cloudflare Access application covers.
  "workers_dev": false
  // No committed `vars` (audit F7): AUTHFLEET_API_URL is a local-dev-only
  // fallback read from the shell environment; production must use the API
  // service binding above. Access verification config
  // (AUTHFLEET_ACCESS_TEAM_DOMAIN / AUTHFLEET_ACCESS_AUD) is set as
  // Worker vars/secrets at deploy time — see README "Deploy".
}
